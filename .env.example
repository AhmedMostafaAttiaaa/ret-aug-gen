# Copy this file to .env and fill in the values for your chosen provider.
# Only the section matching LLM_PROVIDER needs real values; the rest can stay blank.

# Choose an LLM provider: gemini | openai | ollama | anthropic
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- OpenAI (or any OpenAI-compatible API) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (local, no API key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Anthropic Claude (embeddings run locally, no key needed for those) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# --- Backend server ---
SERVER_PORT=8080
EMBEDDING_STORE_PATH=embedding-store.json
